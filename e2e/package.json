    "@wdio/spec-reporter": "^10.2.0",
    "appium": "^4.0.0",
    "appium-uiautomator2-driver": "^9.2.1",
    "appium-xcuitest-driver": "^13.1.1",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "undici": "8.12.4"
